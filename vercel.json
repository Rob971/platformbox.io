{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/workspace(/:match*)?", "destination": "https://platformbox-delivery.fly.dev/:match*" }
  ],
  "headers": [
    {
      "source": "/workspace(/:match*)?",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
