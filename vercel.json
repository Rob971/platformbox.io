{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/workspace/admin",         "destination": "/admin/delivery",         "permanent": false },
    { "source": "/workspace/admin/:match*", "destination": "/admin/delivery/:match*", "permanent": false },
    { "source": "/workspace",         "destination": "/admin",         "permanent": false },
    { "source": "/workspace/:match*", "destination": "/admin/:match*", "permanent": false }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/admin/:match*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
